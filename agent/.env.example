# Required shared secret for internal endpoints (minimum 16 characters).
AGENT_INTERNAL_TOKEN=replace-with-a-secure-internal-token

# Deterministic default: do not make PubChem network requests.
AGENT_OFFLINE_MODE=true

# Used only when AGENT_OFFLINE_MODE=false; range is (0, 10] seconds.
AGENT_PUBCHEM_TIMEOUT_SECONDS=2.0

# MySQL is the durable store for runs, chat, audits and canonical knowledge.
AGENT_MYSQL_HOST=127.0.0.1
AGENT_MYSQL_PORT=3306
AGENT_MYSQL_USER=root
AGENT_MYSQL_PASSWORD=root123
AGENT_MYSQL_DATABASE=ai_medical_db
AGENT_MYSQL_CONNECT_TIMEOUT_SECONDS=10
AGENT_MYSQL_READ_TIMEOUT_SECONDS=30
AGENT_MYSQL_WRITE_TIMEOUT_SECONDS=30

# Redis Stack persists LangGraph checkpoints (RediSearch and RedisJSON are required).
AGENT_REDIS_URL=redis://:redis123@127.0.0.1:6379/0
AGENT_REDIS_CHECKPOINT_PREFIX=medical_agent_checkpoint
AGENT_REDIS_CHECKPOINT_WRITE_PREFIX=medical_agent_checkpoint_write

# Go LLM proxy and business knowledge search used by dynamic chat ReAct turns.
AGENT_LLM_PROXY_URL=http://127.0.0.1:8080/internal/v1/llm/chat
AGENT_LLM_TIMEOUT_SECONDS=30
# optional falls back to /chat before any streamed content; required fails the turn.
AGENT_LLM_STREAM_MODE=optional
AGENT_KNOWLEDGE_API_URL=http://127.0.0.1:8080/internal/v1/knowledge/search
AGENT_KNOWLEDGE_TIMEOUT_SECONDS=10
AGENT_CHAT_MAX_AGENT_ROUNDS=8
AGENT_CHAT_MAX_TOOL_CALLS=12
AGENT_CHAT_EVENT_PAYLOAD_CHARS=4000

# Number of background analysis and chat workers.
AGENT_WORKER_COUNT=2

# Maximum deduplicated condition cells in a generated proposal.
AGENT_PROPOSAL_MAX_CONDITIONS=12

# Managed knowledge base. Canonical metadata is in MySQL; Elasticsearch is mandatory
# for lexical retrieval. Vector retrieval remains independently configurable.
AGENT_VECTOR_MODE=disabled
AGENT_QDRANT_URL=http://localhost:6333
AGENT_QDRANT_API_KEY=
# Toxicology chat index alias.
AGENT_QDRANT_COLLECTION_ALIAS=toxicology_active
AGENT_EVIDENCE_TENANT_ID=default
AGENT_EVIDENCE_PROJECT_ID=toxicology
AGENT_QDRANT_TIMEOUT_SECONDS=5

# Elasticsearch is the only lexical retrieval backend.
AGENT_LEXICAL_BACKEND=elasticsearch

# Local Elasticsearch connection.
AGENT_ELASTICSEARCH_URL=http://127.0.0.1:9200
AGENT_ELASTICSEARCH_INDEX_ALIAS=medical_toxicology_current
AGENT_ELASTICSEARCH_USERNAME=
AGENT_ELASTICSEARCH_PASSWORD=
AGENT_ELASTICSEARCH_TIMEOUT_SECONDS=3
AGENT_ELASTICSEARCH_VERIFY_CERTS=false
# Optional CA bundle for HTTPS clusters; leave empty for local HTTP.
AGENT_ELASTICSEARCH_CA_CERTS=

# The real model is lazy-loaded only when vector work is requested. Install with:
# uv sync --extra embedding. Production selection must pass the retrieval evaluation gate.
AGENT_EMBEDDING_PROVIDER=sentence_transformers
AGENT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AGENT_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
AGENT_EMBEDDING_DIMENSION=384
AGENT_EMBEDDING_NORMALIZE=true
AGENT_EMBEDDING_DEVICE=cpu
AGENT_EMBEDDING_MAX_SEQ_LENGTH=512
AGENT_EMBEDDING_BATCH_SIZE=16
AGENT_EMBEDDING_TIMEOUT_SECONDS=30
AGENT_EMBEDDING_RETRIES=2

AGENT_CHUNK_TOKEN_BUDGET=480
AGENT_CHUNK_TOKEN_OVERLAP=64
AGENT_CHUNKER_VERSION=structure-first-v1
AGENT_LEXICAL_CANDIDATE_LIMIT=100
AGENT_VECTOR_CANDIDATE_LIMIT=100
AGENT_FUSION_RRF_K=60
AGENT_FUSION_POLICY_VERSION=rrf-v1
AGENT_INGESTION_BATCH_SIZE=32
AGENT_INGESTION_WORKER_LIMIT=2
