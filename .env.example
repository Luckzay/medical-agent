# 环境变量模板 —— 可入 git（不含密码）
# 复制此文件为 .env 并填入真实值

DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_medical_db

SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# RocketMQ（MVP 仍使用 HTTP 调度；异步任务接入时使用）
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
ROCKETMQ_TOPIC=medical-agent-runs
ROCKETMQ_CONSUMER_GROUP=medical-agent-workers

JWT_SECRET=

MEILI_ADDR=http://127.0.0.1:7700
MEILI_API_KEY=masterKey

# Python Agent 内部服务
AGENT_SERVICE_URL=http://127.0.0.1:8090
AGENT_SERVICE_TIMEOUT_SECONDS=10
# 必填：至少 16 个字符，每个环境使用不同随机密钥
AGENT_INTERNAL_TOKEN=
# Python Agent 后台工作线程数
AGENT_WORKER_COUNT=2
# LLM 摘要模式：disabled=关闭；optional=失败时回退确定性结果；required=失败即任务失败
AGENT_LLM_MODE=optional
# Agent 只调用 Go 内部代理，不直接接触 LLM API Key
AGENT_LLM_PROXY_URL=http://127.0.0.1:8080/internal/v1/llm/chat
AGENT_LLM_TIMEOUT_SECONDS=30
# 流式输出：optional=流端点不可用且尚未输出时回退普通请求；required=流式失败即失败
AGENT_LLM_STREAM_MODE=optional
# 聊天 Agent 的数据库知识检索与安全上限
AGENT_KNOWLEDGE_API_URL=http://127.0.0.1:8080/internal/v1/knowledge/search
AGENT_KNOWLEDGE_TIMEOUT_SECONDS=10
AGENT_CHAT_MAX_AGENT_ROUNDS=8
AGENT_CHAT_MAX_TOOL_CALLS=12
AGENT_CHAT_EVENT_PAYLOAD_CHARS=4000
# Go 服务用于加密管理员录入的 LLM API Key；必须是 32 字节原文或 Base64 编码的 32 字节随机值
# 示例生成：openssl rand -base64 32
LLM_ENCRYPTION_KEY=
# 默认返回的文献证据数量
AGENT_EVIDENCE_TOP_K=10

# 真实本地向量基线（模型在首次 embedding 时才下载）
# disabled=仅 FTS5；optional=向量失败后带原因降级；required=向量失败即请求失败
AGENT_VECTOR_MODE=required
AGENT_QDRANT_URL=http://localhost:6333
AGENT_QDRANT_COLLECTION_ALIAS=medical_evidence_active
AGENT_SUPRAMOLECULAR_COLLECTION=supramolecular_experiments_active
# 受信 runtime scope；模型传入的 tenant/project 不得覆盖
AGENT_EVIDENCE_TENANT_ID=default
AGENT_EVIDENCE_PROJECT_ID=literature
AGENT_EMBEDDING_PROVIDER=sentence_transformers
AGENT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AGENT_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
AGENT_EMBEDDING_DIMENSION=384
AGENT_EMBEDDING_NORMALIZE=true
AGENT_EMBEDDING_DEVICE=cpu
AGENT_EMBEDDING_MAX_SEQ_LENGTH=512
AGENT_EMBEDDING_BATCH_SIZE=16
AGENT_CHUNK_TOKEN_BUDGET=480
AGENT_CHUNK_TOKEN_OVERLAP=64

# 可选 Reranker：默认 disabled，保持现有融合顺序且启动时不加载模型
# optional=失败时保留 fused 排序；required=失败即明确报错
AGENT_RERANKER_MODE=disabled
AGENT_RERANKER_PROVIDER=disabled
# 启用真实 provider 时设为 cross_encoder；权重仅在首次 rerank 请求加载
AGENT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AGENT_RERANKER_REVISION=main
AGENT_RERANKER_DEVICE=cpu
AGENT_RERANKER_BATCH_SIZE=8
AGENT_RERANKER_CANDIDATE_LIMIT=50
AGENT_LEXICAL_CANDIDATE_LIMIT=100
AGENT_VECTOR_CANDIDATE_LIMIT=100
AGENT_FUSION_RRF_K=60
